      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cause) (rate(cdc_outbox_dead_letter_failures_total[5m]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ],
      "title": "Dead-letter SINK failures (CRITICAL)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
