          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cause) (rate(cdc_outbox_messages_dead_lettered_total[5m]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(cdc_outbox_messages_dead_lettered_total)",
          "legendFormat": "total (cumulative)",
          "refId": "B"
        }
      ],
      "title": "Dead-lettered (rate by cause + total)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Rate of dead-letter SINK failures — i.e. the DLQ itself is failing to receive. ANY sustained non-zero value here is critical: retries have been exhausted AND we cannot park the event. Operator MUST intervene.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
